{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$username": {
        // The PIN is never readable by a client. It can only be written once,
        // at sign-up, which is also what makes claiming a username atomic.
        "pin": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}$/)"
        },

        // Readable so sign-up can tell whether a username is already taken.
        "profile": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || root.child('sessions/' + auth.uid + '/username').val() === $username)",

          "displayName": {
            ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 20"
          },
          "createdAt": { ".validate": "newData.isNumber()" },
          "lastLoginAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },

        "settings": {
          // Private Account preferences use the same proved-session check as Cities.
          ".read": "auth != null && root.child('sessions/' + auth.uid + '/username').val() === $username",
          ".write": "auth != null && root.child('sessions/' + auth.uid + '/username').val() === $username",

          // Each list is a set of lowercase two-letter Country codes.
          "livedInCountries": {
            "$countryCode": {
              ".validate": "$countryCode.matches(/^[a-z]{2}$/) && newData.val() === true"
            }
          },
          "plannedCountries": {
            "$countryCode": {
              ".validate": "$countryCode.matches(/^[a-z]{2}$/) && newData.val() === true"
            }
          },
          // Legacy single values: the app moves them into the lists, then deletes them.
          "homeCountry": {
            ".validate": "!newData.exists()"
          },
          "plannedCountry": {
            ".validate": "!newData.exists()"
          },
          "$other": { ".validate": false }
        },

        // Only reachable by a session that has proved this account's PIN.
        "cities": {
          ".read": "auth != null && root.child('sessions/' + auth.uid + '/username').val() === $username",
          ".write": "auth != null && root.child('sessions/' + auth.uid + '/username').val() === $username",

          "$cityId": {
            ".validate": "newData.hasChildren(['cityName', 'position']) && (!newData.child('image').exists() || !newData.child('memories').exists())",

            "cityName": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
            },
            "country": { ".validate": "newData.isString() && newData.val().length <= 120" },
            "emoji": { ".validate": "newData.isString() && newData.val().length <= 16" },
            "date": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "datePrecision": { ".validate": "newData.val() === 'day' || newData.val() === 'month'" },
            "visitCount": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() % 1 === 0" },
            "notes": { ".validate": "newData.isString() && newData.val().length <= 2000" },
            "image": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 2000000)" },
            "memories": {
              // Realtime Database rules cannot count children. The app limits Cities to five Memories.
              "$memoryId": {
                ".validate": "newData.isString() && newData.val().length <= 2000000"
              }
            },
            "createdAt": { ".validate": "newData.isNumber()" },

            "position": {
              ".validate": "newData.hasChildren(['lat', 'lng'])",
              "lat": {
                ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
              },
              "lng": {
                ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
              },
              "$other": { ".validate": false }
            },

            "$other": { ".validate": false }
          }
        },

        "$other": { ".validate": false }
      }
    },

    // This is the PIN check. The write only succeeds when the submitted PIN
    // equals the one stored for that username, so a wrong PIN is rejected by
    // the database rather than by client code -- and the stored PIN never has
    // to be readable by anyone.
    "sessions": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['username', 'pin']) && root.child('users/' + newData.child('username').val() + '/pin').val() === newData.child('pin').val()",

        "username": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_-]{3,20}$/)"
        },
        "pin": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}$/)"
        },
        "$other": { ".validate": false }
      }
    }
  }
}
